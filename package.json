{
  "name": "nammit",
  "private": true,
  "version": "0.0.0",
  "description": "Name your project and check if the domains are available, using AI agents.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"tsx watch --env-file=.env --import ./instrument.mjs src/server/index.ts\" \"vite --config web/vite.config.ts\"",
    "mastra:dev": "PORT=4111 mastra dev --dir src/mastra",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx --env-file-if-exists=.env --import ./instrument.mjs src/server/index.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "sanity": "tsx --env-file=.env scripts/sanity.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.102",
    "@hono/node-server": "^2.1.5",
    "@mastra/core": "^1.78.0",
    "@mastra/observability": "^1.21.0",
    "@sentry/node": "^11.8.0",
    "ai": "^7.0.148",
    "hono": "^4.13.13",
    "ollama-ai-provider-v2": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "mastra": "^1.34.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1"
}
